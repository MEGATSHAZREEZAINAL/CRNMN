VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio Configuration (Client-side)
VITE_TWILIO_ENVIRONMENT=test      # 'test' or 'live'
VITE_TWILIO_WHATSAPP_NUMBER=+14155238886  # Twilio WhatsApp sandbox number
VITE_TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Test Environment Credentials
VITE_TWILIO_TEST_ACCOUNT_SID=your-test-account-sid
VITE_TWILIO_TEST_AUTH_TOKEN=your-test-auth-token

# Live Environment Credentials  
VITE_TWILIO_LIVE_ACCOUNT_SID=your-live-account-sid
VITE_TWILIO_LIVE_AUTH_TOKEN=your-live-auth-token

# Server-side Twilio Configuration
# These are used by the Node.js server (twilio-real-server.js)
# Get these values from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
