# Twilio Configuration
# Copy this file to .env.local and fill in your actual values

# Environment (test or live)
VITE_TWILIO_ENVIRONMENT=test

# Test Environment Credentials
VITE_TWILIO_TEST_ACCOUNT_SID=YOUR_TWILIO_TEST_ACCOUNT_SID
VITE_TWILIO_TEST_AUTH_TOKEN=your-test-auth-token
VITE_TWILIO_TEST_PHONE_NUMBER=+18126338712

# Live Environment Credentials
VITE_TWILIO_LIVE_ACCOUNT_SID=YOUR_TWILIO_LIVE_ACCOUNT_SID
VITE_TWILIO_LIVE_AUTH_TOKEN=your-live-auth-token
VITE_TWILIO_LIVE_PHONE_NUMBER=+1234567890
VITE_TWILIO_LIVE_WHATSAPP_NUMBER=+1234567890

# Default Numbers (will use test or live based on environment)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_NUMBER=+14155238886
VITE_TWILIO_PHONE_NUMBER=+18126338712

# WhatsApp Bot Configuration
VITE_WHATSAPP_BOT_ENABLED=true

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Webhook Configuration
VITE_WEBHOOK_SECRET=your-webhook-secret-change-in-production
VITE_BASE_URL=http://localhost:5173
