<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="brand-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#39FF14;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2ECC11;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" fill="#121212" rx="64"/>
  
  <!-- Border -->
  <rect x="8" y="8" width="496" height="496" fill="none" stroke="url(#brand-gradient)" stroke-width="4" rx="60"/>
  
  <!-- Icon Content -->
  <g transform="translate(256,256)">
    <!-- Main Logo Shape - Stylized "C" for CORNMAN -->
    <circle cx="0" cy="0" r="120" fill="none" stroke="url(#brand-gradient)" stroke-width="32" stroke-dasharray="0 120 240 120"/>
    
    <!-- Inner Elements -->
    <circle cx="0" cy="-40" r="16" fill="#39FF14"/>
    <circle cx="0" cy="0" r="16" fill="#39FF14"/>
    <circle cx="0" cy="40" r="16" fill="#39FF14"/>
    
    <!-- Text Elements -->
    <text x="0" y="180" text-anchor="middle" fill="url(#brand-gradient)" font-family="Arial, sans-serif" font-size="48" font-weight="bold">HQ</text>
  </g>
</svg>
